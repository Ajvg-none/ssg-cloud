# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:admin@localhost:5432/ssg-cloud?schema=public"

# JWT
JWT_SECRET="tu_clave_super_secreta_cambiala_en_produccion"

# GesVision (credenciales reales de producción)
GESVISION_URL="https://app.gesvision.com/gesmo/rest/api"
GESVISION_USER="usuarioapi_opticolor"
GESVISION_PASS="Usu4r1o_ap1*"

# Whitelist CORS (opcional; el backend sirve la SPA same-origin, así que suele no hacer falta).
# Canónico: FRONTEND_URL. Alias de respaldo: CORS_ORIGIN, CORS_ORIGINS, ALLOWED_ORIGINS.
# Acepta varios orígenes separados por coma, p. ej. "http://localhost:5173,http://127.0.0.1:5173".
FRONTEND_URL="http://localhost:5173"

AGENT_API_KEY=sk-lab-central-abc123def456

# ============================================================
# Entrega de VCA (nativa, fs) — sin agente externo
# ============================================================
VCA_WRITE_TIMEOUT_MS=10000
VCA_MAX_ATTEMPTS=5
VCA_RETRY_CRON=*/30 * * * * *
# Corte de entrega VCA. Vacío = usa el corte persistente en app_settings (sobrevive reinicios).
# Un valor ISO aquí lo sobrescribe manualmente.
VCA_LOCAL_SINCE=
