generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  TIENDA
  LABORATORIO
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  ERROR
}

// Categoría de garantía: DÓNDE originó el defecto (no quién la creó).
// Registrar/extender categorías: backend/src/warrantyCategories/registry.js
enum WarrantyCategory {
  TIENDA
  LABORATORIO
}

// Estado del outbox de entrega VCA (patrón outbox transaccional).
enum VcaOutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

// ============================================================
// MODELOS
// ============================================================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      Role
  storeId   String?  @map("store_id")
  labId     String?  @map("lab_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  lab   Lab?   @relation(fields: [labId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  accn      String   @unique
  labId     String   @map("lab_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lab        Lab        @relation(fields: [labId], references: [id])
  users      User[]
  warranties Warranty[]

  @@map("stores")
}

model Lab {
  id             String    @id @default(cuid())
  name           String
  agentIp        String    @map("ip_agente")
  agentPort      String    @map("puerto_agente")
  vcaNetworkPath String    @map("ruta_vca_red")
  printerName    String    @default("Bixolon") @map("printer_name")
  printEnabled   Boolean   @default(true) @map("print_enabled")
  vcaEnabled     Boolean   @default(true) @map("vca_enabled")
  pollInterval   Int       @default(5000) @map("poll_interval")
  apiKey         String    @unique
  lastHeartbeat  DateTime? @map("last_heartbeat")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  stores     Store[]
  users      User[]
  warranties Warranty[]

  @@map("labs")
}

model OrderCache {
  id          String   @id @default(cuid())
  orderNumber String   @unique @map("order_number")
  rawData     Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("orders_cache")
}

model Warranty {
  id                  String    @id @default(cuid())
  storeId             String    @map("store_id")
  labId               String    @map("lab_id")
  orderNumber         String    @map("order_number")
  revision            Int       @default(1) @map("revision")
  orderData           Json      @map("order_data")
  status              Status    @default(PENDING)
  // Categoría: DÓNDE originó el defecto. Históricas → TIENDA (default de la
  // migración); los clientes que no envían el campo también crean TIENDA.
  category            WarrantyCategory @default(TIENDA)
  processingStartedAt DateTime? @map("processing_started_at")
  processedAt         DateTime? @map("processed_at")
  errorMessage        String?   @map("error_message")
  warrantyType        String?   @map("warranty_type")
  storeObservations   String?   @map("store_observations") @db.VarChar(300)
  // Nuevo campo para controlar cuándo el agente local guardó el VCA
  vcaDeliveredAt DateTime? @map("vca_delivered_at")
  // ✅ NUEVO: reintentos/observabilidad de entrega VCA en modo local (fs)
  vcaAttempts    Int       @default(0) @map("vca_attempts")
  vcaLastError   String?   @map("vca_last_error")
  // ✅ NUEVO: Ojos afectados por el error: 'OD' | 'OI' | 'BOTH' (null para Error de Medida)
  affectedEyes   String?   @map("affected_eyes")
  // ✅ NUEVO — Tipo de garantía "Error de Tipo de Lente (Material)"
  warrantyCase    String?  @map("warranty_case") // 'SAME_ORDER' | 'NEW_ORDER' | null
  newFrameCode    String?  @map("new_frame_code")
  newLensCode     String?  @map("new_lens_code")
  newOrderNumber  String?  @map("new_order_number")
  requiresVca     Boolean  @default(true) @map("requires_vca")
  requiresTicket  Boolean  @default(true) @map("requires_ticket")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  lab   Lab   @relation(fields: [labId], references: [id])

  @@unique([orderNumber, revision])
  @@index([labId, vcaDeliveredAt])
  @@map("warranties")
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  context   Json?
  timestamp DateTime @default(now())

  @@map("logs")
}

// Configuración persistente clave/valor (p. ej. el corte de entrega VCA local).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Outbox transaccional para entrega VCA.
// Se inserta en la misma transacción que la garantía; un worker lo consume.
model VcaOutbox {
  id          String          @id @default(cuid())
  warrantyId  String          @unique @map("warranty_id")
  status      VcaOutboxStatus @default(PENDING)
  attempts    Int             @default(0)
  availableAt DateTime        @default(now()) @map("available_at")
  lockedAt    DateTime?       @map("locked_at")
  lastError   String?         @map("last_error")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@map("vca_outbox")
}